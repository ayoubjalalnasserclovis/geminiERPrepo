# ─── Env des tests d'intégration (tests/integration/*.itest.ts) ──────────────
# Copier en .env.test :  cp .env.test.example .env.test
#
# ⚠️ DOIT pointer vers une base de TEST (Supabase local), JAMAIS la prod.
# Le client de test refuse de tourner si l'URL n'est pas locale, sauf si tu
# poses TEST_DB_ALLOW_REMOTE=true (à utiliser uniquement pour un projet cloud
# de test dédié — jamais la prod).
#
# Les valeurs ci-dessous sont les valeurs PAR DÉFAUT de `npx supabase start`
# (elles sont identiques pour tout le monde en local — ce ne sont pas des secrets).

SUPABASE_TEST_URL=http://127.0.0.1:54321

# service_role : nécessaire pour que les fixtures bypassent le RLS lors du
# setup/cleanup. Récupérée via `npx supabase status` (champ "service_role key").
SUPABASE_TEST_SERVICE_ROLE_KEY=

# anon key : utilisée par les tests qui vérifient le comportement RLS côté client.
SUPABASE_TEST_ANON_KEY=

# Mettre à true UNIQUEMENT pour un projet Supabase cloud de test dédié.
# Laisser vide/false en local.
TEST_DB_ALLOW_REMOTE=
