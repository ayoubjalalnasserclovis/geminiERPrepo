# ─── Supabase (REQUIS) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── App (REQUIS) ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Stoniz

# ─── Cron sécurité (REQUIS pour prod) ─────────────────────────────────
# Générer : `openssl rand -hex 32`
CRON_SECRET=

# ─── Email Resend (OPTIONNEL en local) ────────────────────────────────
# Sans ces variables, les emails sont uniquement loggés en DB.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="Stoniz <hello@stoniz.co>"
EMAIL_REPLY_TO=hello@stoniz.co

# ─── Rate limiting Upstash (OPTIONNEL en local) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Taux de change EUR/MAD (OPTIONNEL — saisie manuelle sinon) ───────
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest?base=EUR&symbols=MAD

# ─── Monitoring (OPTIONNEL) ───────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Environnement ────────────────────────────────────────────────────
NEXT_PUBLIC_VERCEL_ENV=development
